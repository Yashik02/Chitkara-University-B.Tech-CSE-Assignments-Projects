<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderSpace: New</title>
</head>
<body>
    <h3>Create your listing</h3>
    <form action="/listings" method="post">
        <input type="text" name="listing[title]" placeholder="Title:" required >
        <br><br>
        <input type="textArea" name="listing[description]" placeholder="Description:"> <sub>*&lpar;optional&rpar;</sub>
        <br><br>
        <input type="text" name="listing[image]" placeholder="Image URL:" > <sub>*&lpar;optional&rpar;</sub>
        <br><br>
        <input type="number" name="listing[price]" placeholder="Price:" required>
        <br><br>
        <input type="text" name="listing[location]" placeholder="City:" required>
        <br><br>
        <input type="text" name="listing[country]" placeholder="Country:" required>
        <br><br> 
        <button>Submit</button>
    </form>
</body>
