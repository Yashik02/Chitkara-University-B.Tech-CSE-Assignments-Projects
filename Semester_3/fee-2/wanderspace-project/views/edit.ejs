<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderSpace: Edit</title>
</head>
<body>
    <h3>Edit your listing</h3>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="post">
        <input type="text" name="listing[title]" placeholder="Title:" value="<%= listing.title %>" required >
        <br><br>
        <input type="textArea" name="listing[description]" value="<%= listing.description %>" placeholder="Description:"> <sub>*&lpar;optional&rpar;</sub>
        <br><br>
        <input type="text" name="listing[image]" value="<%= listing.image %>" placeholder="Image URL:" > <sub>*&lpar;optional&rpar;</sub>
        <br><br>
        <input type="number" name="listing[price]" value="<%= listing.price %>" placeholder="Price:" required>
        <br><br>
        <input type="text" name="listing[location]" value="<%= listing.location %>" placeholder="City:" required>
        <br><br>
        <input type="text" name="listing[country]" value="<%= listing.country %>" placeholder="Country:" required>
        <br><br> 
        <button>Submit</button>
    </form>
</body>
</html>